8%E7%90%86%E5%A2%9E%E9%95%BF%EF%BC%8C%E5%8F%91%E5%B1%95%E4%B8%93%E8%81%8C%E3%80%81%E5%85%BC%E8%81%8C%E5%92%8C%E5%BF%97%E6%84%BF%E8%80%85%E7%9B%B8%E7%BB%93%E5%90%88%E7%9A%84%E5%85%BB%E8%80%81%E6%9C%8D%E5%8A%A1%E9%98%9F%E4%BC%8D%E3%80%82%3C%2Fspan%3E%3C%2Fp%3E%3Cp%3E%3Cspan+style%3D%22font-family%3A+%E5%AE%8B%E4%BD%93%3B%22%3E%E5%9B%BD%E5%AE%B6%E9%BC%93%E5%8A%B1%E9%AB%98%E7%AD%89%E5%AD%A6%E6%A0%A1%E3%80%81%E4%B8%AD%E7%AD%89%E8%81%8C%E4%B8%9A%E5%AD%A6%E6%A0%A1%E5%92%8C%E8%81%8C%E4%B8%9A%E5%9F%B9%E8%AE%AD%E6%9C%BA%E6%9E%84%E8%AE%BE%E7%BD%AE%E7%9B%B8%E5%85%B3%E4%B8%93%E4%B8%9A%E6%88%96%E8%80%85%E5%9F%B9%E8%AE%AD%E9%A1%B9%E7%9B%AE%EF%BC%8C%E5%9F%B9%E5%85%BB%E5%85%BB%E8%80%81%E6%9C%8D%E5%8A%A1%E4%B8%93%E4%B8%9A%E4%BA%BA%E6%89%8D%E3%80%82%3C%2Fspan%3E%3C%2Fp%3E%3Cp%3E%3Cspan+style%3D%22font-family%3A+%E9%BB%91%E4%BD%93%3B%22%3E%E7%AC%AC%E5%9B%9B%E5%8D%81%E5%85%AB%E6%9D%A1%3C%2Fspan%3E%3Cbr%3E%3C%2Fp%3E%3Cp%3E%3Cspan+style%3D%22font-family%3A+%E9%BB%91%E4%BD%93%3B%22%3E%E7%AC%AC%E5%9B%9B%E5%8D%81%E4%BA%94%E6%9D%A1%3C%2Fspan%3E%3Cspan+style%3D%22font-family%3A+%E5%AE%8B%E4%BD%93%3B%22%3E+%E5%8E%BF%E7%BA%A7%E4%BB%A5%E4%B8%8A%E4%BA%BA%E6%B0%91%E6%94%BF%E5%BA%9C%E6%B0%91%E6%94%BF%E9%83%A8%E9%97%A8%E4%BE%9D%E6%B3%95%E5%B1%A5%E8%A1%8C%E7%9B%91%E7%9D%A3%E6%A3%80%E6%9F%A5%E8%81%8C%E8%B4%A3%EF%BC%8C%E5%8F%AF%E4%BB%A5%E9%87%87%E5%8F%96%E4%BB%A5%E4%B8%8B%E6%8E%AA%E6%96%BD%EF%BC%9A%26lt%3Bbr%2F%3C%2Fspan%3E%3C%2Fp%3E%3Cp%3E%3Cspan+style%3D%22font-family%3A+%E5%AE%8B%E4%BD%93%3B%22%3E%3Cbr%3E%3C%2Fspan%3E%3Cbr%3E%3C%2Fp%3E%3Cp%3E%3Cbr%3E%3C%2Fp%3E&id=30&istui=1&nonce=ispqwdqpkrn&ord=1&subtitle=%E4%B8%AD%E5%9B%BD%E8%80%81%E5%B9%B4%E4%BA%BA%E6%9D%83%E7%9B%8A&timestamp=1789375085&title=%E4%B8%AD%E5%8D%8E%E4%BA%BA%E6%B0%91%E5%85%B1%E5%92%8C%E5%9B%BD%E8%80%81%E5%B9%B4%E4%BA%BA%E6%9D%83%E7%9B%8A%E4%BF%9D%E9%9A%9C%E6%B3%95change-me-2026
[2026-09-14T16:38:05+08:00][error]   收到参数: {"id":"30","title":"中华人民共和国老年人权益保障法","subtitle":"中国老年人权益","category":"2","content":"<p style=\"text-indent: 24.1pt;\"><strong> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 中华人民共和国老年人权益保障法<\/strong><\/p><p><span style=\"color: rgb(0, 0, 255);\"> <\/span><\/p><p style=\"text-align: center;\"><span style=\"font-family: 黑体;\">目 录<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第一章 总 则<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第二章 家庭赡养与扶养<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第三章 社会保障<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第四章 社会服务<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第五章 社会优待<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第六章 宜居环境<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第七章 参与社会发展<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第八章 法律责任<\/span><\/p><p><span style=\"font-family: 宋体;\"> 第九章 附 则<\/span><\/p><p style=\"text-align: center;\"><span style=\"font-family: 黑体;\">第一章 总 则<\/span><\/p><p><span style=\"font-family: 黑体;\">第一条<\/span><span style=\"font-family: 宋体;\"> 为了保障老年人合法权益，发展老龄事业，弘扬中华民族敬老、养老、助老的美德，根据宪法，制定本法。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二条<\/span><span style=\"font-family: 宋体;\"> 本法所称老年人是指六十周岁以上的公民。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三条<\/span><span style=\"font-family: 宋体;\"> 国家保障老年人依法享有的权益。<\/span><\/p><p><span style=\"font-family: 宋体;\">老年人有从国家和社会获得物质帮助的权利，有享受社会服务和社会优待的权利，有参与社会发展和共享发展成果的权利。<\/span><\/p><p><span style=\"font-family: 宋体;\">禁止歧视、侮辱、虐待或者遗弃老年人。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四条<\/span><span style=\"font-family: 宋体;\"> 积极应对人口老龄化是国家的一项长期战略任务。<\/span><\/p><p><span style=\"font-family: 宋体;\">国家和社会应当采取措施，健全保障老年人权益的各项制度，逐步改善保障老年人生活、健康、安全以及参与社会发展的条件，实现老有所养、老有所医、老有所为、老有所学、老有所乐。<\/span><\/p><p><span style=\"font-family: 黑体;\">第五条<\/span><span style=\"font-family: 宋体;\"> 国家建立多层次的社会保障体系，逐步提高对老年人的保障水平。<\/span><\/p><p><span style=\"font-family: 宋体;\">国家建立和完善以居家为基础、社区为依托、机构为支撑的社会养老服务体系。<\/span><\/p><p><span style=\"font-family: 宋体;\">倡导全社会优待老年人。<\/span><\/p><p><span style=\"font-family: 黑体;\">第六条<\/span><span style=\"font-family: 宋体;\"> 各级人民政府应当将老龄事业纳入国民经济和社会发展规划，将老龄事业经费列入财政预算，建立稳定的经费保障机制，并鼓励社会各方面投入，使老龄事业与经济、社会协调发展。<\/span><\/p><p><span style=\"font-family: 宋体;\">国务院制定国家老龄事业发展规划。县级以上地方人民政府根据国家老龄事业发展规划，制定本行政区域的老龄事业发展规划和年度计划。<\/span><\/p><p><span style=\"font-family: 宋体;\">县级以上人民政府负责老龄工作的机构，负责组织、协调、指导、督促有关部门做好老年人权益保障工作。<\/span><\/p><p><span style=\"font-family: 黑体;\">第七条<\/span><span style=\"font-family: 宋体;\"> 保障老年人合法权益是全社会的共同责任。<\/span><\/p><p><span style=\"font-family: 宋体;\">国家机关、社会团体、企业事业单位和其他组织应当按照各自职责，做好老年人权益保障工作。<\/span><\/p><p><span style=\"font-family: 宋体;\">基层群众性自治组织和依法设立的老年人组织应当反映老年人的要求，维护老年人合法权益，为老年人服务。<\/span><\/p><p><span style=\"font-family: 宋体;\">提倡、鼓励义务为老年人服务。<\/span><\/p><p><span style=\"font-family: 黑体;\">第八条<\/span><span style=\"font-family: 宋体;\"> 国家进行人口老龄化国情教育，增强全社会积极应对人口老龄化意识。<\/span><\/p><p><span style=\"font-family: 宋体;\">全社会应当广泛开展敬老、养老、助老宣传教育活动，树立尊重、关心、帮助老年人的社会风尚。<\/span><\/p><p><span style=\"font-family: 宋体;\">青少年组织、学校和幼儿园应当对青少年和儿童进行敬老、养老、助老的道德教育和维护老年人合法权益的法制教育。<\/span><\/p><p><span style=\"font-family: 宋体;\">广播、电影、电视、报刊、网络等应当反映老年人的生活，开展维护老年人合法权益的宣传，为老年人服务。<\/span><\/p><p><span style=\"font-family: 黑体;\">第九条<\/span><span style=\"font-family: 宋体;\"> 国家支持老龄科学研究，建立老年人状况统计调查和发布制度。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十条<\/span><span style=\"font-family: 宋体;\"> 各级人民政府和有关部门对维护老年人合法权益和敬老、养老、助老成绩显著的组织、家庭或者个人，对参与社会发展做出突出贡献的老年人，按照国家有关规定给予表彰或者奖励。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十一条<\/span><span style=\"font-family: 宋体;\"> 老年人应当遵纪守法，履行法律规定的义务。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十二条<\/span><span style=\"font-family: 宋体;\"> 每年农历九月初九为老年节。<\/span><\/p><p style=\"text-align: center;\"><span style=\"font-family: 黑体;\">第二章 家庭赡养与扶养<\/span><\/p><p><span style=\"font-family: 黑体;\">第十三条<\/span><span style=\"font-family: 宋体;\"> 老年人养老以居家为基础，家庭成员应当尊重、关心和照料老年人。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十四条<\/span><span style=\"font-family: 宋体;\"> 赡养人应当履行对老年人经济上供养、生活上照料和精神上慰藉的义务，照顾老年人的特殊需要。<\/span><\/p><p><span style=\"font-family: 宋体;\">赡养人是指老年人的子女以及其他依法负有赡养义务的人。<\/span><\/p><p><span style=\"font-family: 宋体;\">赡养人的配偶应当协助赡养人履行赡养义务。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十五条<\/span><span style=\"font-family: 宋体;\"> 赡养人应当使患病的老年人及时得到治疗和护理；对经济困难的老年人，应当提供医疗费用。<\/span><\/p><p><span style=\"font-family: 宋体;\">对生活不能自理的老年人，赡养人应当承担照料责任；不能亲自照料的，可以按照老年人的意愿委托他人或者养老机构等照料。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十六条<\/span><span style=\"font-family: 宋体;\"> 赡养人应当妥善安排老年人的住房，不得强迫老年人居住或者迁居条件低劣的房屋。<\/span><\/p><p><span style=\"font-family: 宋体;\">老年人自有的或者承租的住房，子女或者其他亲属不得侵占，不得擅自改变产权关系或者租赁关系。<\/span><\/p><p><span style=\"font-family: 宋体;\">老年人自有的住房，赡养人有维修的义务。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十七条<\/span><span style=\"font-family: 宋体;\"> 赡养人有义务耕种或者委托他人耕种老年人承包的田地，照管或者委托他人照管老年人的林木和牲畜等，收益归老年人所有。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十八条<\/span><span style=\"font-family: 宋体;\"> 家庭成员应当关心老年人的精神需求，不得忽视、冷落老年人。<\/span><\/p><p><span style=\"font-family: 宋体;\">与老年人分开居住的家庭成员，应当经常看望或者问候老年人。<\/span><\/p><p><span style=\"font-family: 宋体;\">用人单位应当按照国家有关规定保障赡养人探亲休假的权利。<\/span><\/p><p><span style=\"font-family: 黑体;\">第十九条<\/span><span style=\"font-family: 宋体;\"> 赡养人不得以放弃继承权或者其他理由，拒绝履行赡养义务。<\/span><\/p><p><span style=\"font-family: 宋体;\">赡养人不履行赡养义务，老年人有要求赡养人付给赡养费等权利。<\/span><\/p><p><span style=\"font-family: 宋体;\">赡养人不得要求老年人承担力不能及的劳动。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十条<\/span><span style=\"font-family: 宋体;\"> 经老年人同意，赡养人之间可以就履行赡养义务签订协议。赡养协议的内容不得违反法律的规定和老年人的意愿。<\/span><\/p><p><span style=\"font-family: 宋体;\">基层群众性自治组织、老年人组织或者赡养人所在单位监督协议的履行。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十一条<\/span><span style=\"font-family: 宋体;\"> 老年人的婚姻自由受法律保护。子女或者其他亲属不得干涉老年人离婚、再婚及婚后的生活。<\/span><\/p><p><span style=\"font-family: 宋体;\">赡养人的赡养义务不因老年人的婚姻关系变化而消除。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十二条<\/span><span style=\"font-family: 宋体;\"> 老年人对个人的财产，依法享有占有、使用、收益和处分的权利，子女或者其他亲属不得干涉，不得以窃取、骗取、强行索取等方式侵犯老年人的财产权益。<\/span><\/p><p><span style=\"font-family: 宋体;\">老年人有依法继承父母、配偶、子女或者其他亲属遗产的权利，有接受赠与的权利。子女或者其他亲属不得侵占、抢夺、转移、隐匿或者损毁应当由老年人继承或者接受赠与的财产。<\/span><\/p><p><span style=\"font-family: 宋体;\">老年人以遗嘱处分财产，应当依法为老年配偶保留必要的份额。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十三条 <\/span><span style=\"font-family: 宋体;\">老年人与配偶有相互扶养的义务。<\/span><\/p><p><span style=\"font-family: 宋体;\">由兄、姐扶养的弟、妹成年后，有负担能力的，对年老无赡养人的兄、姐有扶养的义务。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十四条<\/span><span style=\"font-family: 宋体;\"> 赡养人、扶养人不履行赡养、扶养义务的，基层群众性自治组织、老年人组织或者赡养人、扶养人所在单位应当督促其履行。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十五条<\/span><span style=\"font-family: 宋体;\"> 禁止对老年人实施家庭暴力。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十六条<\/span><span style=\"font-family: 宋体;\"> 具备完全民事行为能力的老年人，可以在近亲属或者其他与自己关系密切、愿意承担监护责任的个人、组织中协商确定自己的监护人。监护人在老年人丧失或者部分丧失民事行为能力时，依法承担监护责任。<\/span><\/p><p><span style=\"font-family: 宋体;\">老年人未事先确定监护人的，其丧失或者部分丧失民事行为能力时，依照有关法律的规定确定监护人。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十七条<\/span><span style=\"font-family: 宋体;\"> 国家建立健全家庭养老支持政策，鼓励家庭成员与老年人共同生活或者就近居住，为老年人随配偶或者赡养人迁徙提供条件，为家庭成员照料老年人提供帮助。<\/span><\/p><p style=\"text-align: center;\"><span style=\"font-family: 黑体;\">第三章 社 会 保 障<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十八条<\/span><span style=\"font-family: 宋体;\"> 国家通过基本养老保险制度，保障老年人的基本生活。<\/span><\/p><p><span style=\"font-family: 黑体;\">第二十九条<\/span><span style=\"font-family: 宋体;\"> 国家通过基本医疗保险制度，保障老年人的基本医疗需要。享受最低生活保障的老年人和符合条件的低收入家庭中的老年人参加新型农村合作医疗和城镇居民基本医疗保险所需个人缴费部分，由政府给予补贴。<\/span><\/p><p><span style=\"font-family: 宋体;\">有关部门制定医疗保险办法，应当对老年人给予照顾。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十条<\/span><span style=\"font-family: 宋体;\"> 国家逐步开展长期护理保障工作，保障老年人的护理需求。<\/span><\/p><p><span style=\"font-family: 宋体;\">对生活长期不能自理、经济困难的老年人，地方各级人民政府应当根据其失能程度等情况给予护理补贴。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十一条<\/span><span style=\"font-family: 宋体;\"> 国家对经济困难的老年人给予基本生活、医疗、居住或者其他救助。<\/span><\/p><p><span style=\"font-family: 宋体;\">老年人无劳动能力、无生活来源、无赡养人和扶养人，或者其赡养人和扶养人确无赡养能力或者扶养能力的，由地方各级人民政府依照有关规定给予供养或者救助。<\/span><\/p><p><span style=\"font-family: 宋体;\">对流浪乞讨、遭受遗弃等生活无着的老年人，由地方各级人民政府依照有关规定给予救助。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十二条<\/span><span style=\"font-family: 宋体;\"> 地方各级人民政府在实施廉租住房、公共租赁住房等住房保障制度或者进行危旧房屋改造时，应当优先照顾符合条件的老年人。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十三条<\/span><span style=\"font-family: 宋体;\"> 国家建立和完善老年人福利制度，根据经济社会发展水平和老年人的实际需要，增加老年人的社会福利。<\/span><\/p><p><span style=\"font-family: 宋体;\">国家鼓励地方建立八十周岁以上低收入老年人高龄津贴制度。<\/span><\/p><p><span style=\"font-family: 宋体;\">国家建立和完善计划生育家庭老年人扶助制度。<\/span><\/p><p><span style=\"font-family: 宋体;\">农村可以将未承包的集体所有的部分土地、山林、水面、滩涂等作为养老基地，收益供老年人养老。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十四条<\/span><span style=\"font-family: 宋体;\"> 老年人依法享有的养老金、医疗待遇和其他待遇应当得到保障，有关机构必须按时足额支付，不得克扣、拖欠或者挪用。<\/span><\/p><p><span style=\"font-family: 宋体;\">国家根据经济发展以及职工平均工资增长、物价上涨等情况，适时提高养老保障水平。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十五条<\/span><span style=\"font-family: 宋体;\"> 国家鼓励慈善组织以及其他组织和个人为老年人提供物质帮助。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十六条<\/span><span style=\"font-family: 宋体;\"> 老年人可以与集体经济组织、基层群众性自治组织、养老机构等组织或者个人签订遗赠扶养协议或者其他扶助协议。<\/span><\/p><p><span style=\"font-family: 宋体;\">负有扶养义务的组织或者个人按照遗赠扶养协议，承担该老年人生养死葬的义务，享有受遗赠的权利。<\/span><\/p><p style=\"text-align: center;\"><span style=\"font-family: 黑体;\">第四章 社 会 服 务<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十七条<\/span><span style=\"font-family: 宋体;\"> 地方各级人民政府和有关部门应当采取措施，发展城乡社区养老服务，鼓励、扶持专业服务机构及其他组织和个人，为居家的老年人提供生活照料、紧急救援、医疗护理、精神慰藉、心理咨询等多种形式的服务。<\/span><\/p><p><span style=\"font-family: 宋体;\">对经济困难的老年人，地方各级人民政府应当逐步给予养老服务补贴。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十八条<\/span><span style=\"font-family: 宋体;\"> 地方各级人民政府和有关部门、基层群众性自治组织，应当将养老服务设施纳入城乡社区配套设施建设规划，建立适应老年人需要的生活服务、文化体育活动、日间照料、疾病护理与康复等服务设施和网点，就近为老年人提供服务。<\/span><\/p><p><span style=\"font-family: 宋体;\">发扬邻里互助的传统，提倡邻里间关心、帮助有困难的老年人。<\/span><\/p><p><span style=\"font-family: 宋体;\">鼓励慈善组织、志愿者为老年人服务。倡导老年人互助服务。<\/span><\/p><p><span style=\"font-family: 黑体;\">第三十九条<\/span><span style=\"font-family: 宋体;\"> 各级人民政府应当根据经济发展水平和老年人服务需求，逐步增加对养老服务的投入。<\/span><\/p><p><span style=\"font-family: 宋体;\">各级人民政府和有关部门在财政、税费、土地、融资等方面采取措施，鼓励、扶持企业事业单位、社会组织或者个人兴办、运营养老、老年人日间照料、老年文化体育活动等设施。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十条<\/span><span style=\"font-family: 宋体;\"> 地方各级人民政府和有关部门应当按照老年人口比例及分布情况，将养老服务设施建设纳入城乡规划和土地利用总体规划，统筹安排养老服务设施建设用地及所需物资。<\/span><\/p><p><span style=\"font-family: 宋体;\">公益性养老服务设施用地，可以依法使用国有划拨土地或者农民集体所有的土地。<\/span><\/p><p><span style=\"font-family: 宋体;\">养老服务设施用地，非经法定程序不得改变用途。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十一条<\/span><span style=\"font-family: 宋体;\"> 政府投资兴办的养老机构，应当优先保障经济困难的孤寡、失能、高龄等老年人的服务需求。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十二条<\/span><span style=\"font-family: 宋体;\"> 国务院有关部门制定养老服务设施建设、养老服务质量和养老服务职业等标准，建立健全养老机构分类管理和养老服务评估制度。<\/span><\/p><p><span style=\"font-family: 宋体;\">各级人民政府应当规范养老服务收费项目和标准，加强监督和管理。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十三条<\/span><span style=\"font-family: 宋体;\"> 设立公益性养老机构，应当依法办理相应的登记。<\/span><\/p><p><span style=\"font-family: 宋体;\">设立经营性养老机构，应当在市场监督管理部门办理登记。<\/span><\/p><p><span style=\"font-family: 宋体;\">养老机构登记后即可开展服务活动，并向县级以上人民政府民政部门备案。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十四条<\/span><span style=\"font-family: 宋体;\"> 地方各级人民政府加强对本行政区域养老机构管理工作的领导，建立养老机构综合监管制度。<\/span><\/p><p><span style=\"font-family: 宋体;\">县级以上人民政府民政部门负责养老机构的指导、监督和管理，其他有关部门依照职责分工对养老机构实施监督。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十五条<\/span><span style=\"font-family: 宋体;\"> 县级以上人民政府民政部门依法履行监督检查职责，可以采取以下措施：<\/span><\/p><p><span style=\"font-family: 宋体;\">（一）向养老机构和个人了解情况；<\/span><\/p><p><span style=\"font-family: 宋体;\">（二）进入涉嫌违法的养老机构进行现场检查；<\/span><\/p><p><span style=\"font-family: 宋体;\">（三）查阅或者复制有关合同、票据、账簿及其他有关资料；<\/span><\/p><p><span style=\"font-family: 宋体;\">（四）发现养老机构存在可能危及人身健康和生命财产安全风险的，责令限期改正，逾期不改正的，责令停业整顿。<\/span><\/p><p><span style=\"font-family: 宋体;\">县级以上人民政府民政部门调查养老机构涉嫌违法的行为，应当遵守《中华人民共和国行政强制法》和其他有关法律、行政法规的规定。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十六条<\/span><span style=\"font-family: 宋体;\"> 养老机构变更或者终止的，应当妥善安置收住的老年人，并依照规定到有关部门办理手续。有关部门应当为养老机构妥善安置老年人提供帮助。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十七条<\/span><span style=\"font-family: 宋体;\"> 国家建立健全养老服务人才培养、使用、评价和激励制度，依法规范用工，促进从业人员劳动报酬合理增长，发展专职、兼职和志愿者相结合的养老服务队伍。<\/span><\/p><p><span style=\"font-family: 宋体;\">国家鼓励高等学校、中等职业学校和职业培训机构设置相关专业或者培训项目，培养养老服务专业人才。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十八条<\/span><br><\/p><p><span style=\"font-family: 黑体;\">第四十五条<\/span><span style=\"font-family: 宋体;\"> 县级以上人民政府民政部门依法履行监督检查职责，可以采取以下措施：&lt;br\/<br><br><br><\/span><\/p><p><span style=\"font-family: 黑体;\">第四十四条<\/span><span style=\"font-family: 宋体;\"> 地方各级人民政府加强对本行政区域养老机构管理工作的领导，建立养老机构综合监管制度。<\/span><\/p><p><span style=\"font-family: 宋体;\">县级以上人民政府民政部门负责养老机构的指导、监督和管理，其他有关部门依照职责分工对养老机构实施监督。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十五条<\/span><span style=\"font-family: 宋体;\"> 县级以上人民政府民政部门依法履行监督检查职责，可以采取以下措施：<\/span><\/p><p><span style=\"font-family: 宋体;\">（一）向养老机构和个人了解情况；<\/span><\/p><p><span style=\"font-family: 宋体;\">（二）进入涉嫌违法的养老机构进行现场检查；<\/span><\/p><p><span style=\"font-family: 宋体;\">（三）查阅或者复制有关合同、票据、账簿及其他有关资料；<\/span><\/p><p><span style=\"font-family: 宋体;\">（四）发现养老机构存在可能危及人身健康和生命财产安全风险的，责令限期改正，逾期不改正的，责令停业整顿。<\/span><\/p><p><span style=\"font-family: 宋体;\">县级以上人民政府民政部门调查养老机构涉嫌违法的行为，应当遵守《中华人民共和国行政强制法》和其他有关法律、行政法规的规定。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十六条<\/span><span style=\"font-family: 宋体;\"> 养老机构变更或者终止的，应当妥善安置收住的老年人，并依照规定到有关部门办理手续。有关部门应当为养老机构妥善安置老年人提供帮助。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十七条<\/span><span style=\"font-family: 宋体;\"> 国家建立健全养老服务人才培养、使用、评价和激励制度，依法规范用工，促进从业人员劳动报酬合理增长，发展专职、兼职和志愿者相结合的养老服务队伍。<\/span><\/p><p><span style=\"font-family: 宋体;\">国家鼓励高等学校、中等职业学校和职业培训机构设置相关专业或者培训项目，培养养老服务专业人才。<\/span><\/p><p><span style=\"font-family: 黑体;\">第四十八条<\/span><br><\/p><p><span style=\"font-family: 黑体;\">第四十五条<\/span><span style=\"font-family: 宋体;\"> 县级以上人民政府民政部门依法履行监督检查职责，可以采取以下措施：&lt;br\/<\/span><\/p><p><span style=\"font-family: 宋体;\"><br><\/span><br><\/p><p><br><\/p>","istui":"1","ord":"1","timestamp":"1789375085","nonce":"ispqwdqpkrn","sign":"5aa5de64cb0330bf1f2bb0868890d87c"}
