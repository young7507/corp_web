[2026-09-06T10:39:09+08:00][sql] UPDATE `lh_news`  SET `title` = 'test111' , `subtitle` = '副标题测试1111' , `cate` = 2 , `content` = '<p style=\"text-align: left;\"><span style=\"font-size: 36px;\"><strong style=\"color: blue;\">銅</strong><strong style=\"color: blue;\">板身價的低薪月光族，三年翻身的奇蹟，是幸運?是努力?<br/><br/></strong></span><span style=\"color: #17365D;\"><strong>&nbsp;<span style=\"font-size: 18px;\">一個房屋新建改建、規劃設計、工程管理與創新之全方位房地產達人。曾經也僅是個銅板身價的低薪月光族，在人生谷底手邊毫無協助資源的時候，靠著邊做邊學，習得全方位的房地產法令、營造、工程、設計……等專業能力，憑藉著膽識和毅力親自嘗試體驗投資人生，也開創出各種多元的房地產經營事業與人脈，其年紀輕輕就能成功扭轉人生的傳奇，令高雄當地房產圈及工程業界人士為之驚嘆，素有「房產奇子」之稱。</span></strong></span></p><p><br/></p><p style=\"text-align: left;\"><span style=\"color: #17365D;\"><strong><span style=\"font-size: 18px;\">幾年來專營物件房地產，投資方面無往不利，目前投資過的物件，超過300件以上，包括自拍賣法拍屋、法律點交、房屋估價、經濟評估、取得物件、裝潢設計，到出租、管理、銷售，幾乎全都一手包辦！</span></strong><strong><span style=\"font-size: 18px;\"></span></strong></span></p><p><br/></p><p style=\"text-align: left;\"><span style=\"color: #17365D;\"><strong><span style=\"font-size: 18px;\">精研包裝建築工法、設計，並進口及研發多種建築材料，以降低成本，加快施工進度，這些DIY的過程，都是為了賺取小小的人生自由，簡單的說，就是大家常說的投資客，也是包租公，還是小型建商，要怎麼賺錢？花了數年研究，不敢說無往不利，但真的沒賠過錢！</span></strong><span style=\"font-size: 18px;\"><br/></span></span><span style=\"font-size: 18px; color: #FF0000;\"><br/></span><br/><span style=\"font-size: 24px;\"><strong><span style=\"color: #FF0000;\">房產奇子。慶仔，分享心路與成長歷程的機會講座，邀請您來免費參加!</span></strong></span><br/> &nbsp;<img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535601050678993.png\"/><br/><br/><span style=\"text-align: justify; color: #232323; font-family: Arial, Helvetica, sans-serif, PMingLiU; font-size: 13px; background-color: #FFFFFF;\"></span><br/></p><p><span style=\"text-align: justify; color: #232323; font-family: Arial, Helvetica, sans-serif, PMingLiU; font-size: 13px; background-color: #FFFFFF;\"></span><br/><br/><strong>慶仔｜Davis (房產奇子 方耀慶)</strong><br/><br/></p><p>&nbsp;</p><p>&nbsp;</p><p class=\"mpiteml\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535601399931510.png\"/></p><p>&nbsp;</p><p class=\"mpitemr\" style=\"font-weigth:bold\"><span style=\"font-size: 18px;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;學歷</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　加州州立大學 蒙特爾灣分校 博士後研究員</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　北京中國政法大學 民商法學 在職博士</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　國立高雄大學 創意設計與建築系 碩士</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　國立高雄大學 高阰法律暨管理學系 碩士</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　國立高雄科技大學 財富與稅務 碩士</span></p><p class=\"mpitemr\"><br/><br/><br/></p><p class=\"mpitemr\" style=\"font-weigth:bold\"><span style=\"font-size: 18px;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;現職</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　社團法人高雄市法律知識交流協會 理事長</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　中華民國 經濟部-無形資產評價師</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　中華人民共和國 房地產估價師</span></p><p class=\"mpitemr\"><span style=\"font-size: 18px;\">　　北京TWK圍繞科技有限公司 策略長</span></p><p>　　</p><p>&nbsp;</p><p>&nbsp;</p><p>&nbsp;</p><p>&nbsp;</p><p>&nbsp;</p><p style=\"width: 100%; text-align: center; float: left;\"><span style=\"font-size: 18px; color: #17365D;\"><strong style=\"font-size:27px;color: blue;\">博客來無人能敵的暢銷排行著作</strong></span></p><p class=\"mpitem2\">　　<img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603492449143.jpg\"/><br/>《勇敢用桿-房地產快樂賺錢術》<br/></p><p class=\"mpitem2\">　　<img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603509820655.jpg\"/><br/>《勇敢用桿-法拍屋快樂賺錢術》<br/></p><p class=\"mpitem2\">　　<img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603588558341.jpg\"/><br/>《94狂-素人房地產快樂賺錢術》</p><p>&nbsp;</p><p>&nbsp;</p><p>&nbsp;</p><p>&nbsp;</p><p style=\"width: 100%; text-align: center; margin-top: 65px; float: left;\">我們不空談沒用的理論，只有親身的實戰經驗法則，因為我相信，<br/><strong><span style=\"color: #FF0000; font-size: 24px;\">唯有我做過的，才能真正的教會你!!<br/></span></strong><br/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603166826640.jpg\"/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603166700525.jpg\"/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603166354903.jpg\"/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603166465290.jpg\"/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603166538157.jpg\"/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603166994638.jpg\"/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603746692609.jpg\"/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603746251182.jpg\"/></p><p class=\"mpitem2\"><img title=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" alt=\"房地產快樂賺錢術|房地產,法拍,房屋,法拍屋\" src=\"/upload/image/20180830/1535603746981453.jpg\"/></p><p><strong><span style=\"color: #FF0000; font-size: 24px;\"><br/></span></strong><br/></p>' , `ord` = 3  WHERE  `id` = 4 [ RunTime:0.001424s ]
